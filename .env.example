PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/marine-flight-backend

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Optional: allow additional frontend origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# Optional: SMTP (required only for real email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Cloudinary (required for document/pdf upload features)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Riya flight search integration
RIYA_USERNAME=
RIYA_PASSWORD=
VITE_API_TIMEOUT=30000

# Travel Terminus dual flight search (stage: https://api-stage.travelterminus.com)
TRAVELTERMINUS_BASE_URL=https://api-stage.travelterminus.com
TRAVELTERMINUS_API_KEY=
TRAVELTERMINUS_SECRET_KEY=
TRAVELTERMINUS_API_VERSION=1

# Encryption
ENABLE_ENCRYPTION=false
AES_SECRET=change-me-in-production-must-be-32-chars-long-1234

# Live VEVO visa checks via vSure Visa Checks API v2 (https://developer.vsure.com.au)
# Without these four values /api/visa/check returns 503 VSURE_NOT_CONFIGURED.
VSURE_TOKEN_URL=
VSURE_AUDIENCE=
VSURE_CLIENT_ID=
VSURE_CLIENT_SECRET=
# sandbox until vSure enables production for the account
VSURE_ENVIRONMENT=sandbox
VSURE_MODE=fastcheck
VSURE_API_VERSION=2024-03-05
VSURE_BASE_URL=https://platform.vsure.com.au
# Only needed for New Zealand checks / client-authority setups
VSURE_CUSTOMER_AUTHORITY_ID=
