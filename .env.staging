# Staging Server Environment Configurations
PORT=8000

# Database
# Update with your staging MongoDB URI (e.g., MongoDB Atlas or Render database connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marine-flight-staging?retryWrites=true&w=majority

# JWT Authentication
# Replace with a strong, random key on your staging server
JWT_SECRET=staging-secret-jwt-key-change-me-in-production-12345
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
# Add your staging frontend URL here (e.g. Vercel deployment URL)
CORS_ORIGINS=https://off-shore-frontend.vercel.app

# Email SMTP Settings (Required for notification emails)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Subsea Core Crewing <noreply@yourdomain.com>

# Cloudinary Settings (Required for ticket/passport PDF uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Riya Flight Search API Integration
RIYA_USERNAME=your-riya-username
RIYA_PASSWORD=your-riya-password
VITE_API_TIMEOUT=30000

# Payload Encryption Config
# Set to 'true' to enable AES-256-GCM encryption/decryption, or 'false' to disable
ENABLE_ENCRYPTION=true
# Must be a secure, random string (ideally 32 characters long)
AES_SECRET=staging_aes_secret_key_32_characters_long_9876

# RSA Key Configuration (Required if using RSA auth token decrypt)
# Paste your RSA private key (PEM format) on a single line or as an env block on your host provider
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
