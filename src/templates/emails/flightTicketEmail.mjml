<mjml>
  <mj-head>
    <mj-title>Your Flight Ticket - Marine Flight</mj-title>
    <mj-preview>Your flight booking confirmation and ticket details</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Segoe UI', system-ui, -apple-system, sans-serif" />
      <mj-text color="#1e293b" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0f172a">
    <mj-section padding="32px 24px">
      <mj-column>
        <mj-text font-size="12px" color="#94a3b8" align="center" padding-bottom="8px">
          MARINE FLIGHT
        </mj-text>
        <mj-text font-size="22px" font-weight="700" color="#f8fafc" align="center">
          ✈️ Flight Ticket Confirmation
        </mj-text>
        <mj-text font-size="15px" color="#94a3b8" align="center" padding-top="8px">
          Hello {{crewFirstname}}, your flight has been successfully booked.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px 24px" background-color="#0f172a">
      <mj-column width="100%">
        <mj-wrapper background-color="#1e293b" border-radius="12px" padding="24px">
          <mj-column>
            <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1.5px" padding-bottom="12px">
              Booking Reference
            </mj-text>
            <mj-text font-size="18px" font-weight="700" color="#38bdf8" font-family="'JetBrains Mono', monospace">
              {{bookingReference}}
            </mj-text>
          </mj-column>
        </mj-wrapper>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px 24px" background-color="#0f172a">
      <mj-column width="100%">
        <mj-wrapper background-color="#1e293b" border-radius="12px" padding="24px">
          <mj-column width="55%">
            <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px" padding-bottom="4px">
              From
            </mj-text>
            <mj-text font-size="20px" font-weight="700" color="#f8fafc">
              {{origin}}
            </mj-text>
            <mj-text font-size="14px" color="#94a3b8" padding-top="4px">
              {{departureDate}} · {{departureTime}}
            </mj-text>
          </mj-column>
          <mj-column width="10%" vertical-align="middle" padding="0 8px">
            <mj-text align="center" color="#38bdf8" font-size="20px">→</mj-text>
          </mj-column>
          <mj-column width="35%">
            <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px" padding-bottom="4px">
              To
            </mj-text>
            <mj-text font-size="20px" font-weight="700" color="#f8fafc">
              {{destination}}
            </mj-text>
            <mj-text font-size="14px" color="#94a3b8" padding-top="4px">
              {{arrivalDate}} · {{arrivalTime}}
            </mj-text>
          </mj-column>
        </mj-wrapper>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px 24px" background-color="#0f172a">
      <mj-column>
        <mj-wrapper background-color="#1e293b" border-radius="12px" padding="20px">
          <mj-group>
            <mj-column width="25%">
              <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px">Airline</mj-text>
              <mj-text font-size="15px" font-weight="600" color="#f8fafc">{{airlineName}}</mj-text>
            </mj-column>
            <mj-column width="25%">
              <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px">Duration</mj-text>
              <mj-text font-size="15px" font-weight="600" color="#f8fafc">{{duration}}</mj-text>
            </mj-column>
            <mj-column width="25%">
              <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px">Cabin</mj-text>
              <mj-text font-size="15px" font-weight="600" color="#f8fafc">{{cabin}}</mj-text>
            </mj-column>
            <mj-column width="25%">
              <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px">Total Fare</mj-text>
              <mj-text font-size="15px" font-weight="700" color="#34d399">{{totalFare}} {{currency}}</mj-text>
            </mj-column>
          </mj-group>
        </mj-wrapper>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px 24px" background-color="#0f172a">
      <mj-column>
        <mj-text font-size="12px" color="#64748b" text-transform="uppercase" letter-spacing="1px" padding-bottom="12px">
          Flight Itinerary Details
        </mj-text>
        <mj-raw>{{itineraryHtml}}</mj-raw>
      </mj-column>
    </mj-section>

    <mj-section padding="24px" background-color="#0f172a">
      <mj-column>
        <mj-divider border-color="#334155" border-width="1px" />
        <mj-text font-size="13px" color="#64748b" align="center" padding-top="16px">
          Please arrive at the airport at least 2 hours before departure for international flights.
        </mj-text>
        <mj-text font-size="12px" color="#475569" align="center" padding-top="8px">
          Best regards,<br /><strong>Marine Flight Team</strong>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
