<mjml>
  <mj-head>
    <mj-title>Your Flight Ticket - Marine Flight</mj-title>
    <mj-preview>Your flight booking confirmation and e-ticket details</mj-preview>
    <mj-breakpoint width="520px" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#111827" font-size="13px" line-height="20px" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-table padding="0" />
    </mj-attributes>
    <mj-style>
      .ticket-ref { word-break: break-all; }
      .muted-label { color: #a2a2ad; font-size: 10px; font-weight: 700; text-transform: uppercase; }
      @media (max-width: 520px) {
        .document-padding { padding-left: 24px !important; padding-right: 24px !important; }
        .ticket-title div { text-align: left !important; font-size: 34px !important; }
        .brand-title div { font-size: 24px !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f4f6" width="680px">
    <mj-section padding="34px 0 0" background-color="#f3f4f6">
      <mj-column><mj-spacer height="1px" /></mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" padding="54px 64px 42px">
          <mj-section padding="0 0 22px">
            <mj-column width="50%">
              <mj-text css-class="brand-title" font-size="26px" font-weight="800" color="#111827" line-height="30px">
                Marine <span style="color:#4f46e5;">Flight</span>
              </mj-text>
              <mj-text font-size="11px" color="#9ca3af" padding-top="4px">
                Marine Operations
              </mj-text>
            </mj-column>
            <mj-column width="50%">
              <mj-text css-class="ticket-title" align="right" font-size="38px" font-weight="800" color="#111827" letter-spacing="1px" line-height="42px">
                E-TICKET
              </mj-text>
            </mj-column>
          </mj-section>

          <mj-section padding="0 0 14px">
            <mj-column>
              <mj-divider border-color="#4f46e5" border-width="3px" padding="0" />
            </mj-column>
          </mj-section>

          <mj-section padding="0 0 28px">
            <mj-column>
              <mj-table cellpadding="0" cellspacing="0" width="100%">
                <tr style="background-color:#f4f4f6;">
                  <td style="padding:8px 10px; border:1px solid #ececf1; color:#a2a2ad; font-size:10px; font-weight:700; text-transform:uppercase;">Booking Ref.</td>
                  <td style="padding:8px 10px; border:1px solid #ececf1; color:#a2a2ad; font-size:10px; font-weight:700; text-transform:uppercase;">Date of Issue</td>
                  <td style="padding:8px 10px; border:1px solid #ececf1; color:#a2a2ad; font-size:10px; font-weight:700; text-transform:uppercase;">Departure</td>
                  <td style="padding:8px 10px; border:1px solid #ececf1; color:#a2a2ad; font-size:10px; font-weight:700; text-transform:uppercase;">Fare</td>
                </tr>
                <tr>
                  <td class="ticket-ref" style="padding:10px; border:1px solid #ececf1; color:#111827; font-size:12px; font-weight:700;">{{bookingReference}}</td>
                  <td style="padding:10px; border:1px solid #ececf1; color:#111827; font-size:12px; font-weight:700;">{{issueDate}}</td>
                  <td style="padding:10px; border:1px solid #ececf1; color:#111827; font-size:12px; font-weight:700;">{{departureDate}}</td>
                  <td style="padding:10px; border:1px solid #ececf1; color:#4f46e5; font-size:12px; font-weight:800;">{{currency}} {{totalFare}}</td>
                </tr>
              </mj-table>
            </mj-column>
          </mj-section>

          <mj-section padding="0 0 44px">
            <mj-column width="50%">
              <mj-text font-size="10px" color="#a2a2ad" font-weight="700" text-transform="uppercase" padding-bottom="7px">
                Passenger
              </mj-text>
              <mj-text font-size="13px" color="#111827" font-weight="700" padding-bottom="3px">
                {{crewFirstname}}
              </mj-text>
              <mj-text font-size="13px" color="#111827">
                Confirmed e-ticket
              </mj-text>
            </mj-column>
            <mj-column width="50%">
              <mj-text font-size="10px" color="#a2a2ad" font-weight="700" text-transform="uppercase" padding-bottom="7px">
                Flight Summary
              </mj-text>
              <mj-text font-size="13px" color="#111827" font-weight="700" padding-bottom="3px">
                {{origin}} to {{destination}}
              </mj-text>
              <mj-text font-size="13px" color="#111827">
                {{airlineName}} &middot; {{cabin}} &middot; {{duration}}
              </mj-text>
            </mj-column>
          </mj-section>

          <mj-section padding="0 0 16px">
            <mj-column>
              <mj-table cellpadding="0" cellspacing="0" width="100%">
                <tr style="background-color:#4f46e5;">
                  <td style="padding:10px 12px; color:#ffffff; font-size:11px; font-weight:800; text-transform:uppercase;">Route</td>
                  <td style="padding:10px 12px; color:#ffffff; font-size:11px; font-weight:800; text-transform:uppercase; text-align:center;">Departs</td>
                  <td style="padding:10px 12px; color:#ffffff; font-size:11px; font-weight:800; text-transform:uppercase; text-align:center;">Arrives</td>
                  <td style="padding:10px 12px; color:#ffffff; font-size:11px; font-weight:800; text-transform:uppercase; text-align:right;">Class</td>
                </tr>
                <tr>
                  <td style="padding:16px 12px; border-bottom:1px solid #ececf1; color:#111827; font-size:13px; font-weight:700;">
                    {{origin}} &rarr; {{destination}}<br />
                    <span style="font-weight:400; color:#6b7280;">{{airlineName}}</span>
                  </td>
                  <td style="padding:16px 12px; border-bottom:1px solid #ececf1; color:#111827; font-size:13px; font-weight:700; text-align:center;">
                    {{departureTime}}<br />
                    <span style="font-weight:400; color:#6b7280;">{{departureDate}}</span>
                  </td>
                  <td style="padding:16px 12px; border-bottom:1px solid #ececf1; color:#111827; font-size:13px; font-weight:700; text-align:center;">
                    {{arrivalTime}}<br />
                    <span style="font-weight:400; color:#6b7280;">{{arrivalDate}}</span>
                  </td>
                  <td style="padding:16px 12px; border-bottom:1px solid #ececf1; color:#111827; font-size:13px; font-weight:700; text-align:right;">{{cabin}}</td>
                </tr>
              </mj-table>
            </mj-column>
          </mj-section>

          <mj-section padding="0 0 16px">
            <mj-column>
              <mj-text>{{itineraryHtml}}</mj-text>
            </mj-column>
          </mj-section>

          <mj-section padding="0 0 18px">
            <mj-column>
              <mj-text>{{pdfLinkHtml}}</mj-text>
            </mj-column>
          </mj-section>

          <mj-section padding="2px 0 0">
            <mj-column>
              <mj-table cellpadding="0" cellspacing="0" width="100%">
                <tr>
                  <td style="padding:8px 12px 8px 0; color:#9ca3af; font-size:12px;">Subtotal</td>
                  <td style="padding:8px 0; color:#111827; font-size:12px; font-weight:700; text-align:right;">{{currency}} {{totalFare}}</td>
                </tr>
                <tr>
                  <td style="padding:8px 12px 10px 0; color:#9ca3af; font-size:12px;">Taxes / fees</td>
                  <td style="padding:8px 0 10px; color:#111827; font-size:12px; font-weight:700; text-align:right;">Included</td>
                </tr>
                <tr style="border-top:3px solid #4f46e5; background-color:#f4f4f6;">
                  <td style="padding:13px 12px 13px 10px; color:#111827; font-size:16px; font-weight:800; text-transform:uppercase;">Total Fare</td>
                  <td style="padding:13px 10px 13px 0; color:#4f46e5; font-size:18px; font-weight:800; text-align:right;">{{currency}} {{totalFare}}</td>
                </tr>
              </mj-table>
            </mj-column>
          </mj-section>

          <mj-section padding="34px 0 0">
            <mj-column>
              <mj-divider border-color="#ececf1" border-width="1px" padding="0 0 14px" />
              <mj-text font-size="11px" color="#b4b4be" align="center">
                Please arrive early with a valid photo ID. This is an automated ticket confirmation from Marine Flight.
              </mj-text>
            </mj-column>
          </mj-section>
    </mj-wrapper>

    <mj-section padding="0 0 34px" background-color="#f3f4f6">
      <mj-column><mj-spacer height="1px" /></mj-column>
    </mj-section>
  </mj-body>
</mjml>
