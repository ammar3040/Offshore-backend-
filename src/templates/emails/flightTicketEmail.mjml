<mjml>
  <mj-head>
    <mj-title>Your Flight Ticket - Marine Flight</mj-title>
    <mj-preview>Your flight booking confirmation and e-ticket details</mj-preview>
    <mj-breakpoint width="480px" />
    <mj-attributes>
      <mj-all font-family="'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif" />
      <mj-text color="#e2e8f0" font-size="15px" line-height="24px" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-style>
      .booking-ref { word-break: break-all; }
      .badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; }
      .badge-success { background-color: rgba(52,211,153,0.15); color: #34d399; }
      @media (max-width: 480px) {
        .route-code { font-size: 28px !important; }
        .route-arrow { font-size: 24px !important; }
        .info-label { font-size: 10px !important; }
        .info-value { font-size: 13px !important; }
        .mobile-full-width td { width: 100% !important; display: block !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0b1120" width="600px">

    <!-- Top spacer -->
    <mj-section padding="24px 0 0" background-color="#0b1120">
      <mj-column><mj-spacer height="1px" /></mj-column>
    </mj-section>

    <!-- ===== MAIN CARD ===== -->
    <mj-wrapper background-color="#111827" border-radius="16px" padding="0" css-class="main-card" full-width="full-width">

      <!-- Header gradient bar -->
      <mj-section background-color="#1d4ed8" padding="28px 32px 24px" border-radius="16px 16px 0 0">
        <mj-column width="60%">
          <mj-text font-size="11px" color="rgba(255,255,255,0.6)" text-transform="uppercase" letter-spacing="2px" font-weight="600">
            Marine Flight
          </mj-text>
          <mj-text font-size="20px" font-weight="700" color="#ffffff" padding-top="6px">
            E-Ticket Confirmation
          </mj-text>
        </mj-column>
        <mj-column width="40%">
          <mj-text align="right" padding-top="4px">
            <span class="badge badge-success">&#10003; Confirmed</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Greeting -->
      <mj-section background-color="#111827" padding="28px 32px 4px">
        <mj-column>
          <mj-text font-size="16px" color="#cbd5e1">
            Hello <strong style="color:#f8fafc;">{{crewFirstname}}</strong>, your flight has been booked successfully.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Booking Reference -->
      <mj-section background-color="#111827" padding="16px 32px 24px">
        <mj-column>
          <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1.5px" font-weight="600" padding-bottom="6px">
            Booking Reference
          </mj-text>
          <mj-text font-size="15px" font-weight="700" color="#60a5fa" font-family="'SF Mono', 'Fira Code', 'Consolas', monospace" css-class="booking-ref">
            {{bookingReference}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dashed separator -->
      <mj-section background-color="#111827" padding="0 32px">
        <mj-column>
          <mj-text><div style="border-top: 2px dashed #1e293b; width:100%;"></div></mj-text>
        </mj-column>
      </mj-section>

      <!-- ===== ROUTE SECTION ===== -->
      <mj-section background-color="#111827" padding="28px 32px 8px">
        <mj-column width="38%">
          <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px" font-weight="600">
            Departure
          </mj-text>
          <mj-text font-size="36px" font-weight="800" color="#f8fafc" padding-top="4px" css-class="route-code">
            {{origin}}
          </mj-text>
          <mj-text font-size="13px" color="#94a3b8" padding-top="4px">
            {{departureDate}}
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#e2e8f0" padding-top="2px">
            {{departureTime}}
          </mj-text>
        </mj-column>
        <mj-column width="24%" vertical-align="middle">
          <mj-text align="center" padding-top="16px">
            <div style="color:#475569; font-size:11px; text-transform:uppercase; letter-spacing:1px;">{{duration}}</div>
            <div style="padding:8px 0;">
              <div style="border-top:1px solid #334155; position:relative; margin:0 8px;">
                <div style="width:8px; height:8px; border-radius:50%; background:#3b82f6; position:absolute; left:-4px; top:-5px;"></div>
                <div style="width:8px; height:8px; border-radius:50%; background:#3b82f6; position:absolute; right:-4px; top:-5px;"></div>
              </div>
            </div>
            <div style="color:#3b82f6; font-size:11px; font-weight:600;">{{airlineName}}</div>
          </mj-text>
        </mj-column>
        <mj-column width="38%">
          <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1px" font-weight="600" align="right">
            Arrival
          </mj-text>
          <mj-text font-size="36px" font-weight="800" color="#f8fafc" padding-top="4px" align="right" css-class="route-code">
            {{destination}}
          </mj-text>
          <mj-text font-size="13px" color="#94a3b8" padding-top="4px" align="right">
            {{arrivalDate}}
          </mj-text>
          <mj-text font-size="22px" font-weight="700" color="#e2e8f0" padding-top="2px" align="right">
            {{arrivalTime}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dashed separator -->
      <mj-section background-color="#111827" padding="20px 32px">
        <mj-column>
          <mj-text><div style="border-top: 2px dashed #1e293b; width:100%;"></div></mj-text>
        </mj-column>
      </mj-section>

      <!-- ===== FLIGHT DETAILS GRID ===== -->
      <mj-section background-color="#111827" padding="0 32px 8px">
        <mj-column width="50%" padding-bottom="16px">
          <mj-text font-size="10px" color="#64748b" text-transform="uppercase" letter-spacing="1.2px" font-weight="600" css-class="info-label">
            Airline
          </mj-text>
          <mj-text font-size="15px" font-weight="600" color="#f1f5f9" padding-top="4px" css-class="info-value">
            {{airlineName}}
          </mj-text>
        </mj-column>
        <mj-column width="50%" padding-bottom="16px">
          <mj-text font-size="10px" color="#64748b" text-transform="uppercase" letter-spacing="1.2px" font-weight="600" css-class="info-label">
            Cabin Class
          </mj-text>
          <mj-text font-size="15px" font-weight="600" color="#f1f5f9" padding-top="4px" css-class="info-value">
            {{cabin}}
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-color="#111827" padding="0 32px 8px">
        <mj-column width="50%" padding-bottom="16px">
          <mj-text font-size="10px" color="#64748b" text-transform="uppercase" letter-spacing="1.2px" font-weight="600" css-class="info-label">
            Duration
          </mj-text>
          <mj-text font-size="15px" font-weight="600" color="#f1f5f9" padding-top="4px" css-class="info-value">
            {{duration}}
          </mj-text>
        </mj-column>
        <mj-column width="50%" padding-bottom="16px">
          <mj-text font-size="10px" color="#64748b" text-transform="uppercase" letter-spacing="1.2px" font-weight="600" css-class="info-label">
            Total Fare
          </mj-text>
          <mj-text font-size="18px" font-weight="700" color="#34d399" padding-top="4px" css-class="info-value">
            {{currency}} {{totalFare}}
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Dashed separator -->
      <mj-section background-color="#111827" padding="8px 32px 0">
        <mj-column>
          <mj-text><div style="border-top: 2px dashed #1e293b; width:100%;"></div></mj-text>
        </mj-column>
      </mj-section>

      <!-- ===== ITINERARY ===== -->
      <mj-section background-color="#111827" padding="24px 32px 8px">
        <mj-column>
          <mj-text font-size="11px" color="#64748b" text-transform="uppercase" letter-spacing="1.5px" font-weight="600" padding-bottom="16px">
            Flight Itinerary
          </mj-text>
          <mj-text>{{itineraryHtml}}</mj-text>
        </mj-column>
      </mj-section>

      <!-- ===== PDF LINK (optional) ===== -->
      <mj-section background-color="#111827" padding="0 32px 8px">
        <mj-column>
          <mj-text>{{pdfLinkHtml}}</mj-text>
        </mj-column>
      </mj-section>

      <!-- ===== NOTICE ===== -->
      <mj-section background-color="#0f172a" padding="20px 32px" border-radius="0 0 0 0">
        <mj-column>
          <mj-text font-size="13px" color="#94a3b8" line-height="20px">
            <div style="background:#1e293b; border-radius:10px; padding:16px 20px; border-left:3px solid #3b82f6;">
              <strong style="color:#e2e8f0;">Reminder:</strong> Please arrive at the airport at least 2 hours before departure for domestic and 3 hours for international flights. Carry a valid photo ID.
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section background-color="#111827" padding="20px 32px 28px" border-radius="0 0 16px 16px">
        <mj-column>
          <mj-divider border-color="#1e293b" border-width="1px" padding="0 0 16px" />
          <mj-text font-size="12px" color="#475569" align="center">
            This is an automated confirmation from <strong style="color:#64748b;">Marine Flight</strong>.<br />
            Please do not reply to this email.
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <!-- Bottom spacer -->
    <mj-section padding="0 0 24px" background-color="#0b1120">
      <mj-column><mj-spacer height="1px" /></mj-column>
    </mj-section>

  </mj-body>
</mjml>
